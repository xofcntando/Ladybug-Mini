# Ladybug Mini — environment
# Copy to .env and fill in. Never commit the real .env.

# --- Our own self-hosted Ladybug API (defaults already point here) ---
# Media downloads (song / video / tiktok / facebook / instagram)
YT_API_URL=https://ladybug-api-e8q8.onrender.com
YT_API_KEY=your_ladybug_api_key

# Public API (anime images, reaction GIFs, cards, meme maker, lyrics, AI)
LADYBUG_API_URL=https://ladybug-api-e8q8.onrender.com
LADYBUG_API_KEY=your_ladybug_api_key

# --- Optional third-party fallbacks (only used if the above fail) ---
PRINCE_API_URL=https://api.princetechn.com
PRINCE_API_KEY=prince
